-- - folders -> folders (parent_id) (ON DELETE CASCADE) - in 1.sq and 3.sqm
-- - track_folder_map -> tracks (ON DELETE CASCADE) - in 1.sq and 3.sqm
-- - track_folder_map -> folders (ON DELETE CASCADE) - in 1.sq and 3.sqm
-- - track_stats_prefs -> tracks (ON DELETE CASCADE) - in track_stats_prefs.sq and 4.sqm
